# Optional build-time canonical origin. Defaults to https://aravindsafetynets.in.
# VITE_PUBLIC_URL=https://aravindsafetynets.in

# Optional Airo site ID for the upstream consent banner.
# SITE_ID=

# GoDaddy Inbox environment selector for local API development. The Cloudflare
# Worker uses the production Inbox unless GODADDY_API_BASE_URL is set in its
# runtime variables (not in its build environment).
# GODADDY_API_BASE_URL=

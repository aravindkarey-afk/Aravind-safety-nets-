# Optional build-time canonical origin. Defaults to https://aravindsafetynets.in.
# VITE_PUBLIC_URL=https://aravindsafetynets.in

# Optional Airo site ID for the upstream consent banner.
# SITE_ID=

# Email configuration for Wrangler, not the Vite client. For local delivery tests
# put these keys in a gitignored .dev.vars file; in Cloudflare, store the API key
# as a Worker secret and configure a sender from your verified Resend domain.
# CONTACT_FROM_EMAIL="Aravind Safety Nets <enquiries@mail.aravindsafetynets.in>"
# RESEND_API_KEY=
